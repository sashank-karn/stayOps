# ===========================================================================
# StayOps AI — Environment Configuration Template
# ===========================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env`:
#      cp .env.example .env
# 2. Fill in your actual credentials below.
# 3. NEVER commit `.env` into git. Only `.env.example` is tracked.
# ===========================================================================

# ---------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ---------------------------------------------------------------------------
APP_NAME=StayOps AI
APP_ENV=development                       # development | staging | production
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000        # On Render, set to your Vercel URL (e.g., https://your-project.vercel.app)

# ---------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Supabase / PostgreSQL / SQLite)
# ---------------------------------------------------------------------------
# IMPORTANT FOR SUPABASE:
# Direct connection (db.<ref>.supabase.co) only resolves IPv6 on AWS ap-south-1.
# Always use the Supabase IPv4 Session Pooler (port 5432 or 6543) to avoid IPv6 Errno 11001 errors:
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Local SQLite fallback (Only for quick local tests without internet):
# DATABASE_URL=sqlite:///./stayops.db

# Alternative individual PostgreSQL parameters (used if DATABASE_URL is omitted):
POSTGRES_USER=stayops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stayops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_long_random_secure_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 hours (1440 min) or 60 min

# ---------------------------------------------------------------------------
# 4. LLM & AI PROVIDERS (Configurable)
# ---------------------------------------------------------------------------
# Select provider: "gemini" or "openai"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite           # e.g., gemini-3.5-flash-lite (high quota), gemini-flash-lite-latest, gpt-4o-mini
LLM_TEMPERATURE=0.2

# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
# NOTE: Free Tier provides 15 Requests Per Minute (RPM) & 1,500 Requests Per Day (RPD).
# If you see HTTP 429 ResourceExhausted ("limit: 20 per day"), generate a new standard key at AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional if using Gemini)
OPENAI_API_KEY=your_openai_api_key_here

# Vector Embeddings
EMBEDDING_PROVIDER=gemini                 # gemini | openai
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768                         # 768 for gemini text-embedding-004, 1536 for openai text-embedding-3-small

# ---------------------------------------------------------------------------
# 5. WHATSAPP BUSINESS CLOUD API (Meta Graph API)
# ---------------------------------------------------------------------------
# WhatsApp Graph API endpoint for sending messages
WHATSAPP_API_URL=https://graph.facebook.com/v25.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Meta Permanent Access Token (From System User in Business Manager - Never Expires)
WHATSAPP_ACCESS_TOKEN=EAAB...your_permanent_system_user_token_here
WHATSAPP_TOKEN=EAAB...your_permanent_system_user_token_here  # Alias for WHATSAPP_ACCESS_TOKEN

# Webhook verification token (Set the same string in Meta App Dashboard -> WhatsApp -> Configuration)
WHATSAPP_VERIFY_TOKEN=stayops_wa_verify_token_2026

# ---------------------------------------------------------------------------
# 6. EMAIL DELIVERY SERVICES (Brevo / Resend / SMTP)
# ---------------------------------------------------------------------------
# Option A: Brevo HTTP REST API (Recommended - 300 free emails/day, port 443)
# Get key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option B: Resend HTTP REST API (Optional alternative - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Sender Email Address (Must be a verified sender in Brevo / Resend)
EMAIL_FROM=StayOps Security <noreply@yourdomain.com>

# Legacy SMTP Settings (Optional fallback):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ---------------------------------------------------------------------------
# 7. MULTI-AGENT ORCHESTRATION (n8n Workflow Engine)
# ---------------------------------------------------------------------------
# If true, backend forwards assistant chat queries to n8n webhook.
# If n8n is unreachable or false, backend automatically falls back to internal LangGraph agents.
USE_N8N_ORCHESTRATOR=true
N8N_WEBHOOK_URL=http://localhost:5678/webhook/stayops-agent

# n8n Render / Cloud Stability Flags (Prevent 512MB RAM OOM crashes & SSL hangs):
# - NODE_OPTIONS=--max-old-space-size=350
# - EXECUTIONS_PROCESS=main
# - DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false
# - N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ---------------------------------------------------------------------------
# 8. GOOGLE CALENDAR INTEGRATION (Viewing & Inspection Scheduling)
# ---------------------------------------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# 9. HUMAN-IN-THE-LOOP & AUTONOMOUS POLICIES
# ---------------------------------------------------------------------------
# Maintenance cost (in INR) above which agent pauses and requires human manager approval:
APPROVAL_COST_THRESHOLD=2000

# ---------------------------------------------------------------------------
# 10. RAG PIPELINE & KNOWLEDGE BASE
# ---------------------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_COLLECTION_NAME=course_materials
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
