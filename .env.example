# ===========================================================================
# StayOps AI — environment template.  Copy to .env and fill in real values.
# NEVER commit the real .env file. Only this .env.example is tracked.
# ===========================================================================

# ---------- App ----------
APP_NAME=StayOps AI
APP_ENV=development            # development | staging | production
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ---------- Database (PostgreSQL + pgvector) ----------
POSTGRES_USER=stayops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stayops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full SQLAlchemy URL (built from the parts above by default)
DATABASE_URL=postgresql+psycopg://stayops:change_me@localhost:5432/stayops

# ---------- Authentication (JWT) ----------
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- LLM provider (CONFIGURABLE — pick one) ----------
# LLM_PROVIDER selects which client the agents use. Only the keys for the
# chosen provider need to be set.
LLM_PROVIDER=openai            # openai | gemini
LLM_MODEL=gpt-4o-mini          # e.g. gpt-4o-mini  OR  gemini-1.5-flash
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ---------- Embeddings (for pgvector shared memory) ----------
EMBEDDING_PROVIDER=openai      # openai | gemini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- WhatsApp Business API (Phase 12) ----------
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---------- Human-in-the-loop ----------
# Maintenance cost (INR) above which human approval is required.
APPROVAL_COST_THRESHOLD=2000

# ---------- RAG Pipeline ----------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_COLLECTION_NAME=course_materials
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
