# ===========================================================================
# StayOps AI — environment template.  Copy to .env and fill in real values.
# NEVER commit the real .env file. Only this .env.example is tracked.
# ===========================================================================

# ---------- App ----------
APP_NAME=StayOps AI
APP_ENV=development            # development | staging | production
APP_DEBUG=true
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# ---------- Database (SQLite, PostgreSQL, or Supabase) ----------
# For local dev:
# DATABASE_URL=sqlite:///./stayops.db

# For Supabase (Recommended for Production):
# In Supabase -> Project Settings -> Database -> Connection String (URI / Pooler):
# DATABASE_URL=postgresql://postgres.[project-ref]:[your-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Alternatively, manual PostgreSQL parts:
POSTGRES_USER=stayops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=stayops
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite:///./stayops.db

# ---------- Authentication (JWT) ----------
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- LLM provider (CONFIGURABLE — pick one) ----------
# LLM_PROVIDER selects which client the agents use. Only the keys for the
# chosen provider need to be set.
LLM_PROVIDER=openai            # openai | gemini
LLM_MODEL=gpt-4o-mini          # e.g. gpt-4o-mini  OR  gemini-1.5-flash
LLM_TEMPERATURE=0.2

# OpenAI
OPENAI_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# ---------- Embeddings (for pgvector shared memory) ----------
EMBEDDING_PROVIDER=openai      # openai | gemini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---------- WhatsApp Business API (Phase 12) ----------
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---------- Email Verification (HTTP API or SMTP) ----------
# Modern HTTP REST APIs (port 443 — works behind all firewalls and cloud hosts):
# Option A: Brevo API (300 emails/day free - get key at https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option B: Resend API (100 emails/day free - get key at https://resend.com)
# RESEND_API_KEY=re_your_resend_api_key_here

EMAIL_FROM=StayOps Security <noreply@sashankkarn.com.np>

# Legacy SMTP fallback (optional):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---------- Human-in-the-loop ----------
# Maintenance cost (INR) above which human approval is required.
APPROVAL_COST_THRESHOLD=2000

# ---------- RAG Pipeline ----------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_COLLECTION_NAME=course_materials
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.3
